{
  "$id": "urn:finresearch:web:CreateTaskRequest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of_date": {
      "format": "date",
      "title": "As Of Date",
      "type": "string"
    },
    "baseline_task_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Task Id"
    },
    "company_ids": {
      "items": {
        "pattern": "^\\d{6}\\.(SZ|SH|BJ)$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Company Ids",
      "type": "array"
    },
    "corpus_snapshot_id": {
      "title": "Corpus Snapshot Id",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "LIVE",
        "REPLAY",
        "RULES"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "fiscal_years": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Fiscal Years",
      "type": "array"
    },
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow": {
      "enum": [
        "B1",
        "B2"
      ],
      "title": "Workflow",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "question",
    "workflow",
    "execution_mode",
    "company_ids",
    "fiscal_years",
    "as_of_date",
    "corpus_snapshot_id"
  ],
  "title": "CreateTaskRequest",
  "type": "object"
}
